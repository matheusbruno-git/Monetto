  "criterio_bncc": {
    "regra": "Separar rigorosamente o texto oficial da habilidade BNCC das aplicações específicas criadas pelo Monetto.",
    "observacao": "Nem todo conteúdo financeiro do produto aparece nominalmente na BNCC. Itens como Pix, INSS, taxas bancárias, cartão de crédito, multas e tipos de investimento são contextos pedagógicos que podem mobilizar habilidades da BNCC, mas não devem ser apresentados como se fossem texto oficial da Base.",
    "classificacoes_relacao": {
      "direta": "A habilidade cita educação financeira, Matemática Financeira, orçamento, juros, impostos/contas ou consumo de forma explícita.",
